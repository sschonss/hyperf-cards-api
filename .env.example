APP_NAME=cards-api
APP_ENV=dev
SCAN_CACHEABLE=false

# Credenciais locais da aula. Não use estes valores fora do compose.
DB_DRIVER=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cards
DB_USERNAME=cards
DB_PASSWORD=cards
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_QUERY_LOG=true

# orm | query_builder — o CardService não muda quando este valor muda.
CARD_REPOSITORY=orm

AMQP_HOST=rabbitmq
AMQP_PORT=5672
AMQP_USER=cards
AMQP_PASSWORD=cards
AMQP_VHOST=/
# false na API (só publica). true no container do worker (consome).
AMQP_CONSUMER_ENABLED=false

VAULT_BASE_URL=http://vault:8080
GATEWAY_BASE_URL=http://gateway:8080
VAULT_TIMEOUT=2
GATEWAY_TIMEOUT=2
HTTP_RETRY_ATTEMPTS=3
TRANSACTION_MAX_ATTEMPTS=3

# Usados só pelos mocks.
GATEWAY_LATENCY_MS=0
GATEWAY_SLOW_MS=4000
