{
    "name": "app/cards-api",
    "type": "project",
    "description": "API didática em Hyperf para cadastro de cartões e transações assíncronas.",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "hyperf/amqp": "~3.2.0",
        "hyperf/cache": "~3.2.0",
        "hyperf/command": "~3.2.0",
        "hyperf/config": "~3.2.0",
        "hyperf/database": "~3.2.0",
        "hyperf/db-connection": "~3.2.0",
        "hyperf/engine": "^2.10",
        "hyperf/framework": "~3.2.0",
        "hyperf/guzzle": "~3.2.0",
        "hyperf/http-server": "~3.2.0",
        "hyperf/logger": "~3.2.0",
        "hyperf/memory": "~3.2.0",
        "hyperf/paginator": "~3.2.0",
        "hyperf/process": "~3.2.0",
        "hyperf/validation": "~3.2.0"
    },
    "require-dev": {
        "hyperf/testing": "~3.2.0",
        "mockery/mockery": "^1.0",
        "swoole/ide-helper": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HyperfTest\\": "test/"
        }
    },
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "post-autoload-dump": [
            "rm -rf runtime/container"
        ],
        "test": "co-phpunit --colors=always",
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "php ./bin/hyperf.php start"
        ]
    }
}
